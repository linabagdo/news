#!/bin/bash

# --- НАСТРОЙКИ ---
# Порт и путь (ручка) одинаковые для всех
PORT="8080"
ENDPOINT="api/v1/status" # Пример пути
DATA="2"                # Данные, которые отправляем (-d 2)

# Список IP-адресов (можно добавить сколько угодно)
IPS=(
    "192.168.1.10"
    "192.168.1.15"
    "10.0.0.50"
    "172.16.0.5"
)

# --- СКРИПТ ---
echo "Начинаем отправку запросов..."

for IP in "${IPS[@]}"; do
    echo "Обработка IP: $IP"
    
    # Выполняем curl
    # -s (silent) убирает прогресс-бар, -w выводит код ответа
    curl -X POST "http://${IP}:${PORT}/${ENDPOINT}" \
         -H "Content-Type: text/plain" \
         -d "${DATA}" \
         -w " [HTTP Code: %{http_code}]\n"
    
    # Небольшая пауза между запросами (опционально)
    sleep 1
done

echo "Готово!"



